# Copy to .env on the server. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# OpenAI-compatible endpoint serving the base or SFT Student model.
# A local server may use any non-empty placeholder key.
STUDENT_API_KEY=local-student
STUDENT_BASE_URL=http://127.0.0.1:8000/v1
STUDENT_MODEL=TBD_STUDENT_MODEL

# LlamaFactory OpenAI-compatible API process. Keep API_KEY equal to
# STUDENT_API_KEY and API_MODEL_NAME equal to STUDENT_MODEL.
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=local-student
API_MODEL_NAME=TBD_STUDENT_MODEL

# Windows collection setup. Keep machine paths in .env, not in scripts.
# PYTHON39=C:/path/to/python.exe
# PLATFORM_SOURCE=C:/path/to/SC2Bench

# Server paths. SC2PATH must point to the StarCraft II installation root.
SC2PATH=/opt/StarCraftII
SC2EXP_PLATFORM_SOURCE=platform/SC2Bench
SC2BENCH_OUTPUT_DIR=./runs/raw
HF_HOME=./.cache/huggingface

